---
import { Image } from 'astro:assets';
import AppIcon from '../assets/app-icon.png';
import { getTranslations, t } from '../i18n/translations';
import type { Locale } from '../i18n/config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = getTranslations(locale as Locale);
const mockLabels: string[] =
  (tr as Record<string, any>).hero?.mockLabels ?? [];
const unit = t(tr, 'common.minutesUnit');
const mockMinutes = [5, 25, 60, 120];
---

<div
  class="relative flex w-[160px] sm:w-[180px] flex-col rounded-[2rem] border-2 border-primary-light bg-bg-surface overflow-hidden"
  style="box-shadow: 0 24px 60px rgba(138,90,30,0.22), 0 4px 12px rgba(0,0,0,0.08); aspect-ratio: 9/19.5;"
>
  <div class="flex justify-center pt-3 pb-1 shrink-0">
    <div class="h-[10px] w-[56px] rounded-full bg-text-primary opacity-80"></div>
  </div>

  <div class="flex flex-1 flex-col items-center gap-2 px-3 pb-4">
    <div class="h-10 w-10 overflow-hidden rounded-xl shadow-sm" aria-hidden="true">
      <Image src={AppIcon} alt="" width={80} height={80} class="h-full w-full object-cover" />
    </div>

    <div class="w-full space-y-1.5">
      {mockMinutes.map((min, i) => (
        <div class="flex items-center justify-between rounded-lg bg-bg-muted px-2.5 py-1.5">
          <span class="text-[10px] text-text-secondary truncate max-w-[76px] sm:text-[11px] sm:max-w-[86px]">{mockLabels[i]}</span>
          <span class:list={[
            'text-[11px] font-bold rounded-full px-1.5 py-0.5 sm:text-[12px]',
            min < 30 ? 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' :
            min < 75 ? 'bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-300' :
            'bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300'
          ]}>
            {min}{unit}
          </span>
        </div>
      ))}
    </div>
  </div>

  <div class="flex justify-center pb-2 shrink-0">
    <div class="h-1 w-10 rounded-full bg-text-secondary opacity-40"></div>
  </div>
</div>
